<?xml version="1.0"?>
<package format="2">
  <name>nine_dtact_ft300_ros</name>
  <version>1.0.0</version>
  <description>ROS 1 Noetic wrappers for 9DTact imaging, FT300 collection, physical force prediction, and comparison.</description>
  <maintainer email="liiiin-hku@users.noreply.github.com">9DTact FT300 Project Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>ros_numpy</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export />
</package>
